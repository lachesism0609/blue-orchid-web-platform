{
  "name": "lumiere-fashion-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test tests/frontend-store.test.mjs",
    "test:backend": "node --test tests/cloudflare-api.test.mjs tests/admin-api.test.mjs",
    "test:cloudflare": "npm run test:backend",
    "format": "prettier --write \"src/**/*.{js,jsx}\" tests",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:promote-admin": "node db/promote-admin.js",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.5",
    "vite": "^6.0.5"
  }
}
